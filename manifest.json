{
  "manifest_version": 3,
  "name": "Veil — Jev 留言過濾",
  "version": "0.1.0",
  "description": "依照你的自然語言條件，使用 Jev 隱藏 X 貼文下的文字留言。",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "options.html" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.x.com/*", "https://www.twitter.com/*"],
    "js": ["dom.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
