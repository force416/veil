{
  "manifest_version": 3,
  "name": "Veil — Clef Reply Filter",
  "version": "0.1.0",
  "description": "Hide text replies under X posts with Cloudflare Clef, based on rules you write in plain language.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "host_permissions": ["https://api.cloudflare.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "options.html" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.x.com/*", "https://www.twitter.com/*"],
    "js": ["dom.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
